# Copy this file to .env (or let the Setup Wizard create it for you).
# It holds your X password in clear text - keep it private and never commit it.

X_USERNAME=
X_PASSWORD=

# ADVANCED - leave both empty unless you know you need them.
#
# Empty CHROME_PATH: the app detects your installed Chrome, and falls back to
#   the browser shipped with it.
# Empty CHROME_PROFILE_DIR: the app keeps its own session in data/chrome_profile.
#
# Set CHROME_PATH only to force a specific installation, for example:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome
#
# CHROME_PROFILE_DIR reuses one of your real Chrome profiles. That Chrome must
# stay closed while the app runs - a profile cannot be open in two browsers at
# once. Typical locations:
#   Windows: C:\Users\<user>\AppData\Local\Google\Chrome\User Data\Default
#   macOS:   ~/Library/Application Support/Google/Chrome/Default
#   Linux:   ~/.config/google-chrome/Default
CHROME_PROFILE_DIR=C:\Users\<user>\AppData\Local\Google\Chrome\User Data\Default
#   CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# macOS:
#   CHROME_PROFILE_DIR=~/Library/Application Support/Google/Chrome/Default
#   CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:
#   CHROME_PROFILE_DIR=~/.config/google-chrome/Default
#   CHROME_PATH=/usr/bin/google-chrome
CHROME_PROFILE_DIR=
CHROME_PATH=

# true = invisible browser, false = watch it work (useful when X asks for a code)
HEADLESS=true

# How often the scheduler looks for posts to hand to X (5-3600 seconds)
CHECK_INTERVAL_SECONDS=15

# Retries before a scheduled post is marked as failed (0-10)
MAX_RETRIES=1

# Optional: HTTP port for the local server (default 5000, auto-falls back if busy)
# PORT=5000

# Optional: keep data/, logs/ and .env somewhere else
# XPM_HOME=
